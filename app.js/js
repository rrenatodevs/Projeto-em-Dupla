document.addEventListener("DOMContentLoaded", () => {
  // ==========================================
  // 1. MODO ESCURO / CLARO (DARK MODE)
  // ==========================================
  const btnTema = document.querySelector(".btn-tema");
  const body = document.body;

  // Verificar se o usuário já tinha salvo uma preferência anteriormente
  const temaSalvo = localStorage.getItem("tema");
  if (temaSalvo === "dark") {
    body.classList.add("dark-mode");
  }

  if (btnTema) {
    btnTema.addEventListener("click", () => {
      body.classList.toggle("dark-mode");

      // Salvar a preferência no navegador (localStorage)
      if (body.classList.contains("dark-mode")) {
        localStorage.setItem("tema", "dark");
      } else {
        localStorage.setItem("tema", "light");
      }
    });
  }

  // ==========================================
  // 2. SIMULADOR INTERATIVO (QUIZ)
  // ==========================================
  const quizForm = document.getElementById("quiz-form");
  const resultadoContainer = document.getElementById("resultado-container");
  const resultadoTitulo = document.getElementById("resultado-titulo");
  const resultadoTexto = document.getElementById("resultado-texto");

  if (quizForm) {
    quizForm.addEventListener("submit", (e) => {
      e.preventDefault();

      const p1 = parseInt(document.getElementById("p1").value);
      const p2 = parseInt(document.getElementById("p2").value);
      const p3 = parseInt(document.getElementById("p3").value);

      const pontuacaoTotal = p1 + p2 + p3;

      resultadoContainer.classList.remove("d-none", "bg-light", "bg-warning", "bg-danger", "text-dark", "text-white");

      if (pontuacaoTotal >= 8) {
        resultadoContainer.style.backgroundColor = "var(--verde-salvia)";
        resultadoTitulo.textContent = "Equilíbrio Saudável! 🌱";
        resultadoTexto.textContent = "Você consegue aproveitar a autonomia do trabalho remoto sem perder o contato social e o sentimento de pertencimento.";
      } else if (pontuacaoTotal >= 5) {
        resultadoContainer.style.backgroundColor = "var(--caramelo)";
        resultadoTitulo.textContent = "Alerta de Isolamento Médio ⚠️";
        resultadoTexto.textContent = "A sua rotina remota funciona, mas começa a dar sinais de desconexão. Tente incluir mais momentos presenciais ou pausas ativas durante a semana.";
      } else {
        resultadoContainer.style.backgroundColor = "var(--azul-petroleo)";
        resultadoContainer.classList.add("text-white");
        resultadoTitulo.textContent = "Perfil: Expatriado de Sofá em Risco 🚨";
        resultadoTexto.textContent = "A sua rotina indica um elevado nível de isolamento digital e dependência de ferramentas automáticas. É importante procurar redes de apoio locais e estabelecer limites rígidos para o trabalho.";
      }
    });
  }

  // ==========================================
  // 3. GRÁFICO DINÂMICO (CHART.JS)
  // ==========================================
  const ctx = document.getElementById("graficoDesafios");

  if (ctx) {
    new Chart(ctx, {
      type: "bar",
      data: {
        labels: ["Solidão e Isolamento", "Desligar do Trabalho", "Fuso Horário", "Comunicação Assíncrona"],
        datasets: [{
          label: "% dos Trabalhadores",
          data: [23, 22, 19, 16],
          backgroundColor: [
            "#172B3A",
            "#D9A56C",
            "#A8B5A2",
            "#343638"
          ],
          borderRadius: 8
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            max: 30,
            ticks: {
              callback: function(value) {
                return value + "%";
              }
            }
          }
        }
      }
    });
  }
});